# Copy to `.env.local` and set your API base URL (no trailing slash).
# Postman: {{base_url}}/auth/login → e.g. https://api.example.com/api
NEXT_PUBLIC_API_BASE_URL=https://www.urgentelectrical.services/api

# Public site URL for canonical links, sitemap, and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.urgentelectrical.services

# Ideal Postcodes — server-side only (postcode lookup on checkout)
IDEAL_POSTCODES_API_KEY=
